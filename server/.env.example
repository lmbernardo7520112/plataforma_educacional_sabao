# ==========================================================
# EcoSabon Server — Environment Variables
# ==========================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.
# ==========================================================

# --- Required ---
NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://localhost:27017/ecosabon
JWT_SECRET=change-me-use-a-strong-secret

# --- CORS ---
# Comma-separated list of allowed origins.
# In development, defaults to localhost:5173 and 127.0.0.1:5173 if omitted.
# In production, this variable is REQUIRED.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
# Window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window (default: 100)
RATE_LIMIT_MAX=100

# --- Restricted Pilot Mode ---
# Controls if access is limited to a closed set of teachers
PILOT_MODE=false
# Comma-separated list of authorized teacher emails (only checked in pilot mode)
PILOT_ALLOWED_TEACHER_EMAILS=professor1@example.com,professor2@example.com
# Controls if student/squad logins are enabled during the pilot (default: false)
PILOT_ALLOW_SQUAD_LOGIN=false
# Comma-separated list of classroom names allowed in public onboarding (only checked in pilot mode)
PILOT_PUBLIC_CLASSROOM_NAMES=3ºANO A,3ºANO B

# --- Upload ---
# Max upload size is configured in server/middleware/upload.ts (default: 5MB)
# Allowed MIME types: image/jpeg, image/png, image/webp
