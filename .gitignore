# ============================================================
# EcoSabon — Git Ignore
# ============================================================

# Dependencies
node_modules/

# Build outputs
shared/dist/
client/dist/
curso-interativo/dist/
curso-interativo/dist-scorm/
curso-interativo/coverage/
*.zip

# Environment (secrets)
server/.env

# Uploads (user-generated content)
server/uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Gemini
.gemini/

# ============================================================
# E-book EcoSabon — Build & temp artifacts
# ============================================================
ebook-ecosabon-prototipo/dist/
ebook-ecosabon-prototipo/demo-assets/
ebook-ecosabon-prototipo/scripts/
ebook-ecosabon-prototipo/*.mp4
ebook-ecosabon-prototipo/*.py
ebook-ecosabon-prototipo/src/styles/main-print.css

# ============================================================
# Tools & utilities (Kotobee, EPUB temp, etc.)
# ============================================================
tools/

# ============================================================
# Reports — governance docs are tracked; only temp logs ignored
# ============================================================
# reports/  (tracked — governance and SDD artifacts)
reports/kotobee-plantanatomy-benchmark-ecosabon/

# ============================================================
# Python cache
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ============================================================
# Large media / binary files (general)
# ============================================================
*.mp4
*.avi
*.mov
*.mkv
*.epub

# Generated release artifacts — not versioned in main
release/

